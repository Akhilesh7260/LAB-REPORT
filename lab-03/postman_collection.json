{
  "info": {
    "_postman_id": "lab-03-rest-api-collection",
    "name": "Lab 03 - Books REST API",
    "description": "Postman Collection for Backend Development Fundamentals Lab 03 REST API with CRUD, Search, Sort, Filter, and Pagination.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET / - API Welcome",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": ["{{base_url}}"],
          "path": [""]
        }
      }
    },
    {
      "name": "2. GET /books - Get All Books",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books",
          "host": ["{{base_url}}"],
          "path": ["books"]
        }
      }
    },
    {
      "name": "3. GET /books?search_q=Java - Search by Title",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books?search_q=Java",
          "host": ["{{base_url}}"],
          "path": ["books"],
          "query": [
            {
              "key": "search_q",
              "value": "Java"
            }
          ]
        }
      }
    },
    {
      "name": "4. GET /books?order_by=price&order=DESC - Sort by Price DESC",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books?order_by=price&order=DESC",
          "host": ["{{base_url}}"],
          "path": ["books"],
          "query": [
            {
              "key": "order_by",
              "value": "price"
            },
            {
              "key": "order",
              "value": "DESC"
            }
          ]
        }
      }
    },
    {
      "name": "5. GET /books?min_price=300&max_price=600 - Filter by Price Range",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books?min_price=300&max_price=600",
          "host": ["{{base_url}}"],
          "path": ["books"],
          "query": [
            {
              "key": "min_price",
              "value": "300"
            },
            {
              "key": "max_price",
              "value": "600"
            }
          ]
        }
      }
    },
    {
      "name": "6. GET /books?limit=3&offset=0 - Pagination",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books?limit=3&offset=0",
          "host": ["{{base_url}}"],
          "path": ["books"],
          "query": [
            {
              "key": "limit",
              "value": "3"
            },
            {
              "key": "offset",
              "value": "0"
            }
          ]
        }
      }
    },
    {
      "name": "7. GET /books/:id - Get Book by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books/1",
          "host": ["{{base_url}}"],
          "path": ["books", "1"]
        }
      }
    },
    {
      "name": "8. POST /books - Create Book",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"The Art of Programming\",\n  \"author\": \"John Smith\",\n  \"price\": 499,\n  \"pages\": 320\n}"
        },
        "url": {
          "raw": "{{base_url}}/books",
          "host": ["{{base_url}}"],
          "path": ["books"]
        }
      }
    },
    {
      "name": "9. PUT /books/:id - Update Book",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"The Pragmatic Programmer (2nd Edition)\",\n  \"author\": \"David Thomas\",\n  \"price\": 500,\n  \"pages\": 380\n}"
        },
        "url": {
          "raw": "{{base_url}}/books/1",
          "host": ["{{base_url}}"],
          "path": ["books", "1"]
        }
      }
    },
    {
      "name": "10. DELETE /books/:id - Delete Book",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books/1",
          "host": ["{{base_url}}"],
          "path": ["books", "1"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    }
  ]
}
